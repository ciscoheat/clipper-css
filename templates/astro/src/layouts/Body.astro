---
import Html from "../layouts/Html.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Html title={title}>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</Html>
